# ============================================================
# Kunlun Creation Engine — Environment Variables
# Copy this file to .env and fill in your values
# 定位：自用为主，预留商业化扩展
# ============================================================

# --- Neo4j Graph Database ---
# Bolt connection URI. Falls back to SQLite graph mode if unavailable.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# --- Redis Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password

# --- NATS Message Queue ---
NATS_URL=nats://localhost:4222

# ============================================================
# LLM API 配置（支持多Key轮换和成本控制）
# ============================================================

# --- 主 API Key（OpenAI 兼容接口）---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- 备用 API Keys（逗号分隔，自动轮换）---
# 当主Key触发限流或熔断时自动切换
OPENAI_API_KEYS_BACKUP=

# --- DeepSeek API ---
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- LLM 成本控制 ---
# 单次生成最大 Token 数（0=不限制）
LLM_MAX_TOKENS_PER_REQUEST=4096
# 每小时最大 LLM 调用次数（0=不限制）
LLM_MAX_CALLS_PER_HOUR=60
# 每日 Token 预算上限（0=不限制）
LLM_DAILY_TOKEN_BUDGET=500000

# ============================================================
# Application Server
# ============================================================
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# ============================================================
# API 安全（自用也建议启用）
# ============================================================
API_AUTH_ENABLED=false
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_KEY=

# ============================================================
# 速率限制（slowapi）
# ============================================================
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_GENERATE_PER_MINUTE=3
RATE_LIMIT_EXPORT_PER_MINUTE=5

# ============================================================
# 可观测性（商业化储备）
# ============================================================
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=kunlun-engine

# ============================================================
# Data Storage Paths
# ============================================================
# DATA_DIR=./data
# QDRANT_PATH=
# QDRANT_COLLECTION=kunlun_entities
# SQLITE_PATH=

# ============================================================
# AI Detection Thresholds
# ============================================================
AI_THRESHOLD_SENTENCE_CV=0.30
AI_THRESHOLD_CONJUNCTION_DENSITY=3.0
AI_THRESHOLD_PARAGRAPH_CV=0.20
AI_THRESHOLD_OPENING_DIVERSITY=0.35

# ============================================================
# AI Text Humanization (去AI痕迹)
# ============================================================
HUMANIZE_ENABLED=true
HUMANIZE_DEFAULT_STRATEGY=standard
HUMANIZE_AUTO_STRATEGY=false
HUMANIZE_TARGET_SCORE=0.25
HUMANIZE_MAX_PASSES=3

# ============================================================
# Full Pipeline (全管线创作)
# ============================================================
PIPELINE_AUTO_PROOFREAD=true
PIPELINE_AUTO_STRUCTURE_CHECK=true
PIPELINE_AUTO_COHERENCE_CHECK=true
PIPELINE_AUTO_FORESHADOWING_CHECK=true
PIPELINE_CONTEXT_BUDGET=8000
PIPELINE_DEFAULT_GENRE=xuanhuan
PIPELINE_MAX_PARALLEL_AGENTS=5

# ============================================================
# Audit Gate Thresholds
# ============================================================
AUDIT_MAX_NEW_CONCEPTS_PER_CHAPTER=3
AUDIT_MAX_GAPS_BETWEEN_PLEASURE_POINTS=3
AUDIT_MAX_SAME_PLEASURE_TYPE_STREAK=4
AUDIT_ARC_MAX_POSITION_DEVIATION=2
AUDIT_EMOTION_MAX_DEVIATION_PCT=0.30
AUDIT_DIALOGUE_MAX_NONSENSE_PCT=0.20

# ============================================================
# Daemon / Writer
# ============================================================
# 守护进程默认生成章数
DAEMON_DEFAULT_CHAPTERS=10
# Writer 上下文 Token 预算
WRITER_CONTEXT_BUDGET=8000

# ============================================================
# 通知推送（章节完成/错误告警 → Telegram/飞书/企微/Webhook）
# ============================================================
# Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh
# TELEGRAM_CHAT_ID=-1001234567890

# 飞书机器人
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# FEISHU_WEBHOOK_SECRET=your-hmac-secret

# 企业微信机器人
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 通用 Webhook (HMAC-SHA256 签名)
# WEBHOOK_URL=https://your-server.com/hooks/kunlun
# WEBHOOK_SECRET=your-hmac-secret
