{
  "name": "昆仑创作项目",
  "version": "0.2.0",
  "language": "zh",
  "llm": {
    "provider": "openai_compat",
    "baseUrl": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "temperature": 0.7,
    "stream": true
  },
  "daemon": {
    "enabled": false,
    "schedule": {
      "writeInterval": 15,
      "radarInterval": 360
    },
    "maxConcurrentBooks": 2
  },
  "output": {
    "defaultWordCount": 2800,
    "defaultPlatform": "tomato"
  }
}