# 昆仑创作引擎 — 自用最小配置
# 复制此文件为 .env 即可使用
# 完整配置项见 .env.example

# ── 运行模式 (必填) ──────────────────────────────
# personal = 自用模式（零外部服务，SQLite 内置）
# enterprise = 企业模式（需要 Docker 全套服务）
KUNLUN_MODE=personal

# ── LLM 模式 (必填) ──────────────────────────────
# local = 使用 Ollama 本地模型（免费）
# api = 使用云端 API（DeepSeek/OpenAI）
LLM_MODE=local

# 本地模型名称（LLM_MODE=local 时生效）
LLM_LOCAL_MODEL=qwen3:14b

# Ollama 地址（默认本地）
OLLAMA_HOST=http://localhost:11434

# ── API Key（LLM_MODE=api 时必填） ──────────────────
# 至少配置一个即可
# DEEPSEEK_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx

# ── 数据目录 ──────────────────────────────────
# KUNLUN_DATA_DIR=./data

# ── 日志级别 ──────────────────────────────────
# LOG_LEVEL=INFO