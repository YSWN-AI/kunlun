{
  "name": "kunlun-engine",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "analyze": "npx vite-bundle-visualizer",
    "api:gen": "npx openapi-typescript http://127.0.0.1:8000/openapi.json -o src/types/api-generated.ts",
    "api:gen:local": "npx openapi-typescript ./openapi.json -o src/types/api-generated.ts"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@tiptap/vue-3": "^3.26.0",
    "@vicons/antd": "^0.12.0",
    "@vueuse/core": "^14.3.0",
    "echarts": "^6.1.0",
    "naive-ui": "^2.38.0",
    "pinia": "^2.1.0",
    "pinia-plugin-persistedstate": "^3.2.3",
    "vue": "^3.4.0",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "unplugin-vue-components": "^0.27.0",
    "openapi-typescript": "^7.0.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.0.0"
  }
}
